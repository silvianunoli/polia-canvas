# Pólia — variáveis de ambiente
# Copie para `.env` e preencha com os valores reais. O `.env` NÃO vai pro git.
# Estas chaves do Supabase são públicas por design (protegidas por RLS).
# A service role key NUNCA entra aqui — só nos secrets do servidor.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Gemini (Google AI Studio) — gera as entregas das etapas e a guia (Coach).
# Crie em https://aistudio.google.com/apikey. Em prod, vai como secret do Worker.
GEMINI_API_KEY=

# Google Calendar (OAuth) — página /calendario. Crie em https://console.cloud.google.com
# (Calendar API habilitada + tela de consentimento + credencial OAuth "Web application").
# GOOGLE_CALENDAR_REDIRECT_URI precisa bater EXATAMENTE com o registrado no Google
# (dev: http://localhost:5174/calendario · prod: https://tanstack-start-app.usepolia.workers.dev/calendario).
# Em prod, client id/secret vão como secret do Worker.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Stripe — assinatura mensal/anual da Pólia (Configurações > Assinatura).
# Chave publicável (não é segredo, pode ir aqui e é embutida no bundle do client)
# pra inicializar o Payment Element. Pegue em https://dashboard.stripe.com/apikeys.
VITE_STRIPE_PUBLISHABLE_KEY=
# Chave secreta — cria/cancela assinatura no servidor. Mesma página do dashboard
# ("Secret key", começa com sk_live_). Em prod, vai como secret do Worker
# (`wrangler secret put STRIPE_SECRET_KEY`), NUNCA commitada.
STRIPE_SECRET_KEY=
# IDs de preço (não são segredo, só identificadores do produto no Stripe).
STRIPE_PRICE_ID_MENSAL=price_1TqcnPRrhWyvo2EjAHoFAEO2
STRIPE_PRICE_ID_ANUAL=price_1TqcnmRrhWyvo2EjGkr4oTEE
# STRIPE_WEBHOOK_SECRET NÃO entra aqui — é secret da Supabase Edge Function
# (supabase/functions/stripe-webhook), configurado separadamente via Supabase.

# Turnstile (Cloudflare) — anti-spam nos forms públicos (/contato, /lista-de-espera).
# Sitekey não é segredo, embutida no bundle do client. Widget + Worker de validação
# criados via skill turnstile-spin (dash.cloudflare.com > conta > Turnstile).
VITE_TURNSTILE_SITE_KEY=
# URL do Worker que valida o token com o secret do Turnstile (siteverify) — o
# secret NUNCA entra aqui, fica só no `wrangler secret put TURNSTILE_SECRET_KEY`
# do próprio Worker de validação (deploy separado do app principal).
VITE_TURNSTILE_VERIFY_URL=

# Google Analytics (GA4) — Measurement ID não é segredo, embutido no bundle
# do client. Só dispara depois que a usuária aceita cookies de análise no
# banner (mesmo gate do analytics próprio, ver src/lib/cookieConsent.ts).
VITE_GA_MEASUREMENT_ID=

# Emissor do recibo de assinatura (Configurações > Assinatura, plano pago).
# Hoje a Pólia emite como pessoa física (CPF) — não é segredo, aparece em todo
# recibo baixado, mas fica no ambiente (não hardcoded) pra poder trocar sem deploy
# de código e não versionar dado pessoal direto no git.
POLIA_EMISSOR_NOME=
POLIA_EMISSOR_CPF=
POLIA_EMISSOR_ENDERECO=
