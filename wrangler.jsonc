{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  // Nitro (preset cloudflare-module) mescla isto em dist/server/wrangler.json
  // (junto com main/no_bundle/rules, gerados automaticamente). Sem
  // run_worker_first, toda rota SSR cai em 404 direto do asset server, sem
  // rodar o Worker — derrubou o site em produção em 2026-07-27. Causa real:
  // node_modules estava dessincronizado do package-lock.json
  // (@cloudflare/vite-plugin 1.33.1 instalado vs 1.43.3 travado no lockfile),
  // e a versão antiga não gerava dist/server/wrangler.json corretamente. `npm
  // install` resincronizou; deixando explícito aqui como defesa a mais, caso
  // o node_modules destrave de novo no futuro.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "usepolia.com.br", "custom_domain": true },
    // www não tinha DNS nenhum (não resolvia). Custom domain do Worker
    // provisiona o registro sozinho; o handler em src/server.ts redireciona
    // 301 pro domínio sem www.
    { "pattern": "www.usepolia.com.br", "custom_domain": true }
    // silvianunoli.com.br (área de gestão) foi extraído pro Worker "polia-admin"
    // (projeto polia-admin/), deploy e domínio próprios — ver src/server.ts pro
    // redirect que ainda manda /admin de usepolia.com.br pra lá.
  ],
  // Mantém o subdomínio *.workers.dev ativo como fallback além do domínio
  // próprio (Wrangler desativa ele por padrão assim que "routes" aparece).
  "workers_dev": true
}
